# Database
DATABASE_URL=postgresql+asyncpg://wildlink:wildlink_dev@localhost:5432/wildlink_db
DATABASE_URL_SYNC=postgresql://wildlink:wildlink_dev@localhost:5432/wildlink_db

# Security
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Application
APP_NAME=WildLink AI
APP_ENV=development
DEBUG=true
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data paths
DATA_DIR=./data
MODEL_DIR=./ml/models
RASTER_DIR=./data/rasters

# Map
DEFAULT_MAP_CENTER_LAT=23.5
DEFAULT_MAP_CENTER_LNG=80.5
DEFAULT_MAP_ZOOM=7
